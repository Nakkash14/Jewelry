# Browser-safe public configuration only.
# These VITE_* names are inlined into the client bundle at build time.
# Never put Admin API tokens, client secrets, database URLs, or webhook
# secrets in this file or in any VITE_* variable.
#
# Copy to frontend/.env.local (gitignored) when local values are needed.
# Values below are names and placeholders only — leave blank until that phase.

# --- Shopify Storefront (public) ---
# Shop hostname only, e.g. your-store.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=

# Pin a stable quarterly Storefront API version (not "unstable" or "latest")
VITE_SHOPIFY_STOREFRONT_API_VERSION=

# Public Storefront access token from the Headless channel.
# Visible to buyers by design. Do not use the private Storefront token here.
VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# --- Our Node API ---
# Origin of the custom backend, e.g. http://localhost:PORT
VITE_API_URL=

# --- Feature flags (hide unfinished UI) ---
# Use true or false. Defaults should keep unfinished features off.
VITE_FEATURE_CUSTOMER_ACCOUNTS=false
VITE_FEATURE_APPOINTMENTS=false
VITE_FEATURE_REVIEWS=false
VITE_FEATURE_CONTACT=false
VITE_FEATURE_NEWSLETTER=false
