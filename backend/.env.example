# Server-only secrets and configuration.
# Never prefix these with VITE_. Never copy them into the frontend bundle.
#
# Copy to backend/.env (gitignored) when local values are needed.
# Values below are names and placeholders only — leave blank until that phase.
#
# Do not add Shopify Admin API, webhook, email, analytics, or Sentry
# secrets until those phases. They are not required for foundations.

# --- Process ---
NODE_ENV=development
PORT=

# Allowed browser origin for CORS, e.g. http://localhost:3000
FRONTEND_ORIGIN=

# --- PostgreSQL (custom app data + auth/session state only) ---
# Placeholder shape: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# --- Session / token encryption ---
# Random long strings. Not Shopify credentials.
SESSION_COOKIE_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Shopify (server) ---
# Same shop hostname as the frontend, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Same pinned quarterly version as VITE_SHOPIFY_STOREFRONT_API_VERSION
SHOPIFY_STOREFRONT_API_VERSION=

# Private Storefront token from the Headless channel. Server only.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Customer Account API confidential/web client (Headless channel).
# Client secret must never appear in VITE_* or the frontend repo files.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# HTTPS callback registered in the Headless Customer Account settings.
# Shopify does not accept localhost or http for this URL.
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=
